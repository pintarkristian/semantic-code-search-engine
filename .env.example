# semcode configuration — copy to .env and edit as needed

# --- server ---
APP_NAME=semcode
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=pretty   # "pretty" for dev, "json" for prod / Docker

# --- embedding model ---
# Any sentence-transformers-compatible model; code-aware models work best.
EMBEDDING_MODEL_NAME=flax-sentence-embeddings/st-codesearch-distilroberta-base
# Set to "cuda" to use GPU inference (requires faiss-gpu and CUDA toolkit)
EMBEDDING_DEVICE=cpu
BATCH_SIZE=64
MAX_CHUNK_TOKENS=512

# --- paths ---
DATA_DIR=data
FAISS_INDEX_PATH=data/index.faiss
METADATA_PATH=data/metadata.parquet
RERANKER_MODEL_PATH=data/reranker

# --- retrieval ---
TOP_K_RETRIEVE=50
TOP_K_RETURN=10

# --- fusion weights ---
DENSE_WEIGHT=0.7
BM25_WEIGHT=0.3
